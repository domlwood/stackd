# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by seed / user:create scripts and trusted server services. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Seed users (invite-only app: these are the only accounts)
SEED_USER_A_EMAIL=
SEED_USER_A_NAME=
SEED_USER_A_PASSWORD=
SEED_USER_B_EMAIL=
SEED_USER_B_NAME=
SEED_USER_B_PASSWORD=
SEED_WORKSPACE_NAME=Our deals

# Ingestion kill-switch (Phase 5)
INGEST_RIGHTMOVE_ENABLED=true
