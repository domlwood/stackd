{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-user.ts",
    "verify:live": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-finance.ts && tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-tax-rules.ts",
    "screenshots": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/screenshot.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@workspace/ui": "*",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
