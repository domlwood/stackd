{
  "name": "stackd",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-next-themes.mjs",
    "build": "turbo build",
    "cf:build": "npm run cf:build -w web",
    "cf:deploy": "npm run cf:deploy -w web",
    "cf:preview": "npm run cf:preview -w web",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "check": "turbo typecheck lint test",
    "db:types": "supabase gen types typescript --linked --schema public > apps/web/src/lib/supabase/database.types.ts",
    "db:push": "supabase db push",
    "db:seed": "npm run seed -w web",
    "user:create": "npm run user:create -w web --",
    "user:update": "npm run user:update -w web --"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
